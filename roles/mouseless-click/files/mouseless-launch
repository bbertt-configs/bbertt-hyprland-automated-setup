#!/usr/bin/env bash
# Autostart entry point for Sonuscape Mouseless.
#
# Why this wrapper exists instead of `exec-once = flatpak run net.sonuscape.mouseless`
# directly: excluded_input_devices has to be kept up to date with whichever physical
# keyboards are actually plugged in, but Sonuscape reads its config.yaml once at
# startup and rewrites the whole file from memory when it exits. That means the ONLY
# safe window to edit the file is while the app is not running -- immediately before
# launch is the natural (and only reliable) place to do it.
#
# Sequence: merge the exclusion list into config.yaml (best-effort), then exec the
# flatpak. Losing mouse control entirely is worse than a stale exclusion list, so
# every step of the merge is allowed to fail without blocking the launch.

set -uo pipefail

CONFIG="$HOME/.var/app/net.sonuscape.mouseless/data/mouseless/configs/config.yaml"
EXTRA_FILE="$HOME/.config/mouseless-click/extra-excludes"
DEVICES_BIN="$HOME/.local/bin/mouseless-devices"
APP_ID="net.sonuscape.mouseless"
APP_NAME="Sonuscape Mouseless launcher"

log() { printf '%s\n' "$*" >&2; }

# Internal mode: perform the actual textual merge for one config file. Entries to
# union in are read from stdin, one per line. Split out like this so it can be
# invoked directly (by merge_config below, or by hand/tests) without re-running
# device detection.
if [ "${1:-}" = "--merge-config" ]; then
    config_path="${2:?config path required}"

    read -r -d '' PYCODE <<'PYEOF'
import os
import re
import shutil
import stat
import subprocess
import sys

JBENSMANN_NAME = "mouseless keyboard"
JBENSMANN_VENDOR = "4711"
JBENSMANN_PRODUCT = "0815"


def is_wildcard(field):
    return field in ("0", "0000")


def is_unsafe(entry):
    e = entry.strip()
    if not e:
        return True
    m = re.match(r'^ids:([0-9a-fA-F]+):([0-9a-fA-F]+)$', e)
    if m:
        vendor = m.group(1).lower()
        product = m.group(2).lower()
        vendor_bad = is_wildcard(vendor) or vendor == JBENSMANN_VENDOR
        product_bad = is_wildcard(product) or product == JBENSMANN_PRODUCT
        return vendor_bad and product_bad
    return e.lower() in JBENSMANN_NAME.lower()


def strip_quotes(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ('"', "'"):
        return s[1:-1]
    return s


def parse_existing(text):
    # Case 1: inline empty list, e.g. "excluded_input_devices: []"
    m = re.search(r'^excluded_input_devices:[ \t]*\[\][ \t]*$', text, re.MULTILINE)
    if m:
        return [], (m.start(), m.end()), 'inline'

    # Case 2: non-empty inline flow list, e.g. excluded_input_devices: [a, "b c"].
    # Deliberately simple: single line, no nested brackets, no escaped quotes --
    # none of those are valid device entries anyway.
    m = re.search(r'^excluded_input_devices:[ \t]*\[([^\[\]]*)\][ \t]*$', text, re.MULTILINE)
    if m:
        entries = [strip_quotes(item) for item in m.group(1).split(',') if item.strip()]
        return entries, (m.start(), m.end()), 'inline'

    # Case 3: block sequence, "excluded_input_devices:" followed by one or more
    # "- entry" lines. Indentation is intentionally optional (0 or more spaces/tabs)
    # -- Sonuscape itself writes items at column 0 when it rewrites the file on
    # exit, and this parser has to round-trip that, not just the indented style
    # Ansible originally wrote. Requires at least one entry line, so a header with
    # nothing recognisable under it (nested mapping, empty block, etc.) falls
    # through to the unrecognised-form check below instead of being treated as
    # an empty list -- that would silently orphan whatever actually follows it.
    m = re.search(
        r'^excluded_input_devices:[ \t]*\n((?:^[ \t]*-[ \t]*.*\n?)+)',
        text, re.MULTILINE,
    )
    if m:
        entries = []
        for line in m.group(1).splitlines():
            lm = re.match(r'^[ \t]*-[ \t]*(.+?)[ \t]*$', line)
            if lm:
                entries.append(strip_quotes(lm.group(1)))
        if entries:
            return entries, (m.start(), m.end()), 'block'

    # Case 4: the key exists but in a form none of the above recognise (a YAML
    # anchor, a nested mapping, an empty block, multi-line flow, etc). Never
    # guess here -- claiming it wrongly risks writing a duplicate key or
    # orphaning content. Report it as unrecognised instead.
    if re.search(r'^excluded_input_devices:', text, re.MULTILINE):
        return [], None, 'unrecognized'

    # Case 5: key absent entirely
    return [], None, 'absent'


def format_block(entries):
    if not entries:
        return "excluded_input_devices: []"
    # Column 0, matching Sonuscape's own output style (it rewrites the file this
    # way on exit) so the file stays stable across the launcher->app->launcher
    # round trip instead of churning indentation every cycle.
    lines = ["excluded_input_devices:"]
    for e in entries:
        lines.append(f"- {e}")
    return "\n".join(lines)


def main():
    config_path = sys.argv[1]
    with open(config_path, "r") as f:
        text = f.read()

    new_entries = [line.strip() for line in sys.stdin if line.strip()]

    existing, span, mode = parse_existing(text)

    if mode == "unrecognized":
        print(
            "mouseless-launch: excluded_input_devices is present but not in a "
            "recognised form (not an empty/flow list or a block sequence) -- "
            "leaving config.yaml untouched to avoid corrupting it",
            file=sys.stderr,
        )
        sys.exit(1)

    # Union existing + freshly supplied entries. Never overwrite: an entry already
    # present stays even if that keyboard is currently unplugged. Dedup
    # case-insensitively; keep the first-seen casing.
    seen = {}
    for e in existing + new_entries:
        key = e.lower()
        if key not in seen:
            seen[key] = e

    dropped = []
    safe = []
    for e in seen.values():
        if is_unsafe(e):
            dropped.append(e)
        else:
            safe.append(e)

    safe.sort(key=str.lower)

    for d in dropped:
        print(f"mouseless-launch: dropped unsafe exclusion entry: {d!r} "
              f"(would match jbensmann's virtual keyboard)", file=sys.stderr)

    if dropped and shutil.which("notify-send"):
        msg = "Dropped unsafe entries (would blind Sonuscape):\n" + "\n".join(dropped)
        try:
            subprocess.run(
                ["notify-send", "-a", "Sonuscape Mouseless launcher",
                 "Unsafe exclusion dropped", msg],
                check=False,
            )
        except Exception:
            pass

    block = format_block(safe)

    if mode == "absent":
        sep = "" if text == "" or text.endswith("\n") else "\n"
        new_text = text + sep + block + "\n"
    elif mode == "inline":
        start, end = span
        new_text = text[:start] + block + text[end:]
    else:  # block
        start, end = span
        new_text = text[:start] + block + "\n" + text[end:]

    try:
        orig_mode = stat.S_IMODE(os.stat(config_path).st_mode)
    except OSError:
        orig_mode = None

    tmp_path = config_path + ".mouseless-launch.tmp"
    with open(tmp_path, "w") as f:
        f.write(new_text)
    if orig_mode is not None:
        try:
            os.chmod(tmp_path, orig_mode)
        except OSError:
            pass
    os.replace(tmp_path, config_path)


if __name__ == "__main__":
    main()
PYEOF

    exec python3 -c "$PYCODE" "$config_path"
fi

# Merge the exclusion list into $CONFIG. Every step here is best-effort: a failure
# is logged and swallowed so the app still launches with whatever config it has.
merge_config() {
    local config="$1"

    if [ ! -f "$config" ]; then
        log "mouseless-launch: no config at $config yet (first run) -- skipping" \
            "exclusion merge, launching so Sonuscape can create it"
        return 0
    fi

    local detected="" extra=""

    if [ -x "$DEVICES_BIN" ]; then
        detected=$("$DEVICES_BIN" 2>/dev/null)
        if [ $? -ne 0 ]; then
            log "mouseless-launch: mouseless-devices failed, continuing without new detections"
            detected=""
        fi
    else
        log "mouseless-launch: $DEVICES_BIN not found or not executable, skipping detection"
    fi

    if [ -f "$EXTRA_FILE" ]; then
        extra=$(grep -vE '^[[:space:]]*(#|$)' "$EXTRA_FILE" 2>/dev/null)
    fi

    { printf '%s\n' "$detected"; printf '%s\n' "$extra"; } | "$0" --merge-config "$config"
}

if ! merge_config "$CONFIG"; then
    log "mouseless-launch: exclusion merge failed, launching Sonuscape anyway"
fi

exec flatpak run "$APP_ID" "$@"
