# Managed by the zsh role. Based on LinuxBeginnings/Arch-Hyprland assets/.zshrc
# Local edits are overwritten on the next run (the previous file is kept as a backup).

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

export ZSH="$HOME/.oh-my-zsh"

# Windows Terminal's default Campbell scheme uses #0037DA for blue, which is barely
# visible on a dark background (lsd directories, gnzh's current directory).
# Swap just the blue slots for One Half Dark's via OSC 4. WT_SESSION is only set
# inside Windows Terminal, so other terminals (kitty on Hyprland) keep their theme.
if [ -n "$WT_SESSION" ]; then
    printf '\e]4;4;rgb:61/af/ef\e\\\e]4;12;rgb:61/af/ef\e\\'
fi

ZSH_THEME="gnzh"

plugins=(
    git
    archlinux
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# Check archlinux plugin commands here
# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/archlinux

# Display Pokemon-colorscripts
# Project page: https://gitlab.com/phoneybadger/pokemon-colorscripts#on-other-distros-and-macos
#pokemon-colorscripts --no-title -s -r #without fastfetch
#pokemon-colorscripts --no-title -s -r | fastfetch -c $HOME/.config/fastfetch/config-pokemon.jsonc --logo-type file-raw --logo-height 10 --logo-width 5 --logo -

# fastfetch. Will be disabled if above colorscript was chosen to install
# The compact config ships with Hyprland-Dots; fall back to fastfetch's defaults
# where it isn't installed (e.g. WSL), instead of erroring on every new shell.
if [ -f "$HOME/.config/fastfetch/config-compact.jsonc" ]; then
    fastfetch -c $HOME/.config/fastfetch/config-compact.jsonc
else
    fastfetch
fi

# Set-up icons for files/directories in terminal using lsd
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'

# Set-up FZF key bindings (CTRL R for fuzzy history finder)
source <(fzf --zsh)

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory

# mise (runtime version manager), when installed
if [ -x "$HOME/.local/bin/mise" ]; then
    eval "$($HOME/.local/bin/mise activate zsh)"
fi
